.turbo

# Vercel
.vercel

# Build Outputs
.next/
out/
build
dist


# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
.DS_Store
*.pem
*.key
*.log

project-docs/

# Font files (licensed, not committed)
fonts/*.ttf
fonts/*.otf

# Generated check PDFs
uploads/

# Prisma
prisma/migrations/migration_lock.toml 

# Local test output
/*.pdf
/*.zip 
cookiejar.txt
