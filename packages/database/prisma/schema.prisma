// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PlanType {
  TRIAL
  STARTER
  PROFESSIONAL
  BUSINESS
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum TenantStatus {
  ACTIVE
  CLOSED
  SUSPENDED
}

enum TenantRole {
  OWNER
  ADMIN
  MEMBER
}

model Tenant {
  id               String       @id @default(uuid())
  name             String
  billingEmail     String       @unique @map("billing_email")
  status           TenantStatus @default(ACTIVE)
  stripeCustomerId String?      @unique @map("stripe_customer_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  deletedAt     DateTime? @map("deleted_at")
  deletedReason String?   @map("deleted_reason")

  workspaces    Workspace[]
  auditLogs     AuditLog[]
  tenantMembers TenantMember[]
  subscriptions ProductSubscription[]
  userTokens    UserToken[]

  @@map("tenants")
}

model User {
  id                String    @id @default(uuid())
  fullName          String    @map("full_name")
  email             String    @unique
  // null = invited, no password set yet: the account cannot sign in until the invitation is accepted
  passwordHash      String?   @map("password_hash")
  isActive          Boolean   @default(true) @map("is_active")
  lastLoginAt       DateTime? @map("last_login_at")
  // Account lockout: wrong passwords counted per account (wherever they come from), and
  // the moment the account may be tried again. See the auth service's sign-in.
  failedLoginCount  Int       @default(0) @map("failed_login_count")
  lastFailedLoginAt DateTime? @map("last_failed_login_at")
  lockedUntil       DateTime? @map("locked_until")

  // Two-factor sign-in (authenticator app codes, RFC 6238). The secret is stored
  // ENCRYPTED, never hashed: the server needs it to calculate the expected code.
  // pending = shown during setup, not active until a correct code proves the phone has it.
  mfaSecretEncrypted        String?   @map("mfa_secret_encrypted")
  mfaPendingSecretEncrypted String?   @map("mfa_pending_secret_encrypted")
  mfaPendingCreatedAt       DateTime? @map("mfa_pending_created_at")
  mfaEnabledAt              DateTime? @map("mfa_enabled_at")
  // The last 30-second step a code was accepted for: the same code never works twice.
  mfaLastUsedStep           Int?      @map("mfa_last_used_step")
  // Wrong codes, counted and locked like wrong passwords.
  mfaFailedCount            Int       @default(0) @map("mfa_failed_count")
  mfaLastFailedAt           DateTime? @map("mfa_last_failed_at")
  mfaLockedUntil            DateTime? @map("mfa_locked_until")
  emailVerifiedAt           DateTime? @map("email_verified_at")
  createdAt                 DateTime  @default(now()) @map("created_at")
  updatedAt                 DateTime  @updatedAt @map("updated_at")
  deletedAt                 DateTime? @map("deleted_at")

  tenantMembers             TenantMember[]
  mfaBackupCodes            MfaBackupCode[]
  workspaceMembers          WorkspaceMember[]
  workspaceMemberRoles      WorkspaceMemberRole[]
  createdChecks             Check[]                    @relation("CheckCreatedBy")
  printedChecks             Check[]                    @relation("CheckPrintedBy")
  voidedChecks              Check[]                    @relation("CheckVoidedBy")
  printConfirmedChecks      Check[]                    @relation("CheckPrintConfirmedBy")
  updatedSignatures         BankAccount[]              @relation("BankAccountSignatureUpdatedBy")
  clearedChecks             Check[]                    @relation("CheckClearedBy")
  statusChanges             CheckStatusHistory[]
  uploadedAttachment        CheckAttachment[]
  calibrationProfiles       CalibrationProfile[]       @relation("CalibrationProfileCalibratedBy")
  printBatches              PrintBatch[]
  verifiedCalibrations      CalibrationProfile[]       @relation("CalibrationProfileVerifiedBy")
  auditLogs                 AuditLog[]
  approvalWorkflowApprovers ApprovalWorkflowApprover[]
  approvalRecords           ApprovalRecord[]
  createdApprovalRules      ApprovalWorkflowRule[]
  sessions                  Session[]
  userTokens                UserToken[]                @relation("UserTokenOwner")
  createdUserTokens         UserToken[]                @relation("UserTokenCreatedBy")
  reviewedLeaveRequests     LeaveRequest[]             @relation("LeaveReviewer")
  reviewedRegularizations   AttendanceRegularization[] @relation("RegularizationReviewer")

  @@map("users")
}

model TenantMember {
  id String @id @default(uuid())

  tenantId    String  @map("tenant_id")
  userId      String  @map("user_id")
  invitedById String? @map("invited_by_id")

  role TenantRole @default(MEMBER)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([userId])
  @@index([tenantId, userId, deletedAt])
  @@map("tenant_members")
}

model Product {
  id          String  @id @default(uuid())
  slug        String  @unique @db.VarChar(50)
  name        String  @db.VarChar(100)
  description String?
  iconUrl     String? @map("icon_url")
  isActive    Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")

  subscriptions ProductSubscription[]
  roles         Role[]
  permissions   Permission[]

  @@map("products")
}

model ProductSubscription {
  id        String @id @default(uuid())
  tenantId  String @map("tenant_id")
  productId String @map("product_id")

  plan                 PlanType           @default(TRIAL)
  status               SubscriptionStatus @default(TRIALING)
  trialEndsAt          DateTime?          @map("trial_ends_at")
  currentPeriodEndsAt  DateTime?          @map("current_period_ends_at")
  stripeSubscriptionId String?            @unique @map("stripe_subscription_id")
  canceledAt           DateTime?          @map("canceled_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([tenantId, productId])
  @@index([tenantId])
  @@index([tenantId, status])
  @@map("product_subscriptions")
}

model Role {
  id        String @id @default(uuid())
  productId String @map("product_id")

  slug        String  @db.VarChar(50)
  name        String  @db.VarChar(100)
  description String?
  isSystem    Boolean @default(true) @map("is_system")

  createdAt DateTime @default(now()) @map("created_at")

  product              Product               @relation(fields: [productId], references: [id])
  rolePermissions      RolePermission[]
  workspaceMemberRoles WorkspaceMemberRole[]

  @@unique([productId, slug])
  @@map("roles")
}

model Permission {
  id        String @id @default(uuid())
  productId String @map("product_id")

  action      String  @db.VarChar(100)
  description String?

  product         Product          @relation(fields: [productId], references: [id])
  rolePermissions RolePermission[]

  @@unique([productId, action])
  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Workspace {
  id           String    @id @default(uuid())
  businessName String    @map("business_name")
  addressLine1 String    @map("address_line1")
  addressLine2 String?   @map("address_line2")
  city         String
  state        String    @db.VarChar(2)
  zipCode      String    @map("zip_code") @db.VarChar(10)
  phone        String?   @db.VarChar(20)
  logoUrl      String?   @map("logo_url")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  members               WorkspaceMember[]
  bankAccounts          BankAccount[]
  payees                Payee[]
  checks                Check[]
  calibrationProfiles   CalibrationProfile[]
  printBatches          PrintBatch[]
  auditLogs             AuditLog[]
  approvalRules         ApprovalWorkflowRule[]
  userTokens            UserToken[]
  checkPrintingSettings CheckPrintingSettings?

  // Clock In Clock Out
  attendanceSettings     AttendanceSettings?
  leavePolicies          LeavePolicy[]
  leaveRequests          LeaveRequest[]
  regularizationRequests AttendanceRegularization[]

  @@index([tenantId])
  @@map("workspaces")
}

model CheckPrintingSettings {
  workspaceId     String  @id @map("workspace_id")
  approvalEnabled Boolean @default(false) @map("approval_enabled")
  maxCheckAmount  Decimal @default(999999.99) @map("max_check_amount") @db.Decimal(12, 2)
  maxPastDays     Int     @default(30) @map("max_past_days")
  maxFutureDays   Int     @default(90) @map("max_future_days")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@map("check_printing_settings")
}

model WorkspaceMember {
  id String @id @default(uuid())

  userId      String @map("user_id")
  workspaceId String @map("workspace_id")

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  assignedRoles WorkspaceMemberRole[]

  // Clock In Clock Out
  employeeProfiles AttendanceEmployeeDetails[]

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

model WorkspaceMemberRole {
  id String @id @default(uuid())

  workspaceMemberId String  @map("workspace_member_id")
  roleId            String  @map("role_id")
  assignedById      String? @map("assigned_by_id")

  createdAt DateTime @default(now()) @map("created_at")

  workspaceMember WorkspaceMember @relation(fields: [workspaceMemberId], references: [id], onDelete: Cascade)
  role            Role            @relation(fields: [roleId], references: [id])
  assignedBy      User?           @relation(fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([workspaceMemberId, roleId])
  @@index([roleId])
  @@map("workspace_member_roles")
}

enum AccountType {
  CHECKING
  SAVINGS
}

model BankAccount {
  id                     String      @id @default(uuid())
  workspaceId            String      @map("workspace_id")
  bankName               String      @map("bank_name")
  routingNumberEncrypted String      @map("routing_number_encrypted")
  routingNumberLast4     String      @map("routing_number_last4") @db.VarChar(4)
  accountNumberEncrypted String      @map("account_number_encrypted")
  accountNumberLast4     String      @map("account_number_last4") @db.VarChar(4)
  // HMAC of routing + account number (see src/bank-fingerprint.ts): the same real account
  // always has the same value, so it can be refused twice although the numbers are encrypted.
  // Null for accounts created before it existed, until the backfill script fills it.
  accountFingerprint     String?     @map("account_fingerprint") @db.Char(64)
  accountType            AccountType @default(CHECKING) @map("account_type")
  nextCheckNumber        Int         @map("next_check_number")
  checkNumberPadding     Int         @default(6) @map("check_number_padding")
  // Key of the signature image in encrypted file storage (not a URL: never served directly)
  signatureStorageKey    String?     @map("signature_storage_key")
  signatureUpdatedAt     DateTime?   @map("signature_updated_at")
  signatureUpdatedById   String?     @map("signature_updated_by_id")
  encryptionKeyVersion   Int         @default(1) @map("encryption_key_version")
  isActive               Boolean     @default(true) @map("is_active")
  createdAt              DateTime    @default(now()) @map("created_at")
  updatedAt              DateTime    @updatedAt @map("updated_at")
  deletedAt              DateTime?   @map("deleted_at")

  // Relations
  workspace          Workspace @relation(fields: [workspaceId], references: [id])
  signatureUpdatedBy User?     @relation("BankAccountSignatureUpdatedBy", fields: [signatureUpdatedById], references: [id])

  checks Check[]

  // One record per real account in a workspace (deleted records included, so a removed
  // account is restored with its check numbering instead of added again from #1).
  @@unique([workspaceId, accountFingerprint])
  @@index([workspaceId])
  // The same account in another workspace of the same company is looked up by fingerprint.
  @@index([accountFingerprint])
  @@map("bank_accounts")
}

model Payee {
  id           String  @id @default(uuid())
  name         String
  addressLine1 String? @map("address_line1")
  addressLine2 String? @map("address_line2")
  city         String?
  state        String? @db.VarChar(2)
  zipCode      String? @map("zip_code") @db.VarChar(10)
  defaultMemo  String? @map("default_memo")
  isActive     Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  workspaceId String    @map("workspace_id")
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("payees")
}

// Why a check was voided. Reports and the user's next step depend on it.
enum VoidType {
  CANCELLED // voided before it was printed: no paper exists
  SPOILED // reported spoiled right after printing (jam, smudge): destroy the paper
  VOIDED_AFTER_PRINT // voided later: the paper may have left the office (stop payment)
}

enum CheckStatus {
  NEW
  PENDING_APPROVAL
  APPROVED
  REJECTED
  PRINTED
  CLEARED
  VOID
}

model Check {
  id               String      @id @default(uuid())
  workspaceId      String      @map("workspace_id")
  bankAccountId    String      @map("bank_account_id")
  checkNumber      Int         @map("check_number")
  status           CheckStatus @default(NEW)
  payeeName        String      @map("payee_name")
  amount           Decimal     @db.Decimal(12, 2)
  amountInWords    String      @map("amount_in_words")
  checkDate        DateTime    @map("check_date") @db.Date
  memo             String?
  invoiceTableJson Json?       @map("invoice_table_json")
  pdfStorageUrl    String?     @map("pdf_storage_url")
  // SHA-256 of the stored PDF, checked on every download so a modified file is never served
  pdfSha256        String?     @map("pdf_sha256") @db.Char(64)

  // Starts at 1 and increases on every resubmit. Approval votes belong to one round,
  // so votes cast before an edit never count toward the edited check.
  approvalRound Int @default(1) @map("approval_round")

  // Void fields
  voidReason String?   @map("void_reason")
  voidedAt   DateTime? @map("voided_at")
  voidedById String?   @map("voided_by_id")
  voidType   VoidType? @map("void_type")

  // Print fields
  printedAt   DateTime? @map("printed_at")
  printedById String?   @map("printed_by_id")

  // The printer's report that the paper came out fine (set once; a spoiled print is voided instead)
  printConfirmedAt   DateTime? @map("print_confirmed_at")
  printConfirmedById String?   @map("print_confirmed_by_id")

  // Print snapshot: the printer profile and exact offsets used, kept even if the profile later changes
  calibrationProfileId String?      @map("calibration_profile_id")
  printOffsetXPts      Decimal?     @map("print_offset_x_pts") @db.Decimal(6, 2)
  printOffsetYPts      Decimal?     @map("print_offset_y_pts") @db.Decimal(6, 2)
  printPaperSize       PaperSize?   @map("print_paper_size")
  printLayout          CheckLayout? @map("print_layout")
  // Slot 1-3 on three-per-page paper; null for other layouts
  printPosition        Int?         @map("print_position")
  // The print job when the check was printed together with others (one PDF for all)
  printBatchId         String?      @map("print_batch_id")

  // Cleared fields
  clearedAt     DateTime? @map("cleared_at")
  clearedById   String?   @map("cleared_by_id")
  clearedDate   DateTime? @map("cleared_date") @db.Date
  clearedAmount Decimal?  @map("cleared_amount") @db.Decimal(12, 2)

  // Reissue chain
  reissuedFromCheckId String? @unique @map("reissued_from_check_id")

  // Creator
  createdById String @map("created_by_id")

  // Timestamps
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  workspace          Workspace           @relation(fields: [workspaceId], references: [id])
  bankAccount        BankAccount         @relation(fields: [bankAccountId], references: [id])
  createdBy          User                @relation("CheckCreatedBy", fields: [createdById], references: [id])
  printedBy          User?               @relation("CheckPrintedBy", fields: [printedById], references: [id])
  voidedBy           User?               @relation("CheckVoidedBy", fields: [voidedById], references: [id])
  printConfirmedBy   User?               @relation("CheckPrintConfirmedBy", fields: [printConfirmedById], references: [id])
  clearedBy          User?               @relation("CheckClearedBy", fields: [clearedById], references: [id])
  calibrationProfile CalibrationProfile? @relation(fields: [calibrationProfileId], references: [id], onDelete: SetNull)
  printBatch         PrintBatch?         @relation(fields: [printBatchId], references: [id])
  reissuedFromCheck  Check?              @relation("CheckReissue", fields: [reissuedFromCheckId], references: [id])
  reissuedToCheck    Check?              @relation("CheckReissue")

  statusHistory   CheckStatusHistory[]
  attachments     CheckAttachment[]
  approvalRecords ApprovalRecord[]

  @@unique([bankAccountId, checkNumber])
  @@index([workspaceId, status])
  @@index([workspaceId, checkDate])
  @@index([bankAccountId])
  @@index([workspaceId, payeeName])
  // The check register (F06): number and amount ranges, the default newest-first sort, and the
  // outstanding / stale / aging views (status PRINTED ordered by print time).
  @@index([workspaceId, checkNumber])
  @@index([workspaceId, amount])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, status, printedAt])
  @@index([printBatchId])
  @@map("checks")
}

// One print job of several checks: a single PDF, with each check in its own slot or
// page. Every check in it also keeps its own one-check PDF, so it can be reprinted
// alone; the batch PDF is only handed out while every check in it is still PRINTED.
model PrintBatch {
  id                   String      @id @default(uuid())
  workspaceId          String      @map("workspace_id")
  calibrationProfileId String?     @map("calibration_profile_id")
  checkCount           Int         @map("check_count")
  sheetCount           Int         @map("sheet_count")
  paperSize            PaperSize   @map("paper_size")
  layout               CheckLayout
  // Three-per-page paper: the slot the first check went into, and the one after the last
  startPosition        Int?        @map("start_position")
  nextPosition         Int?        @map("next_position")
  pdfStorageUrl        String      @map("pdf_storage_url")
  pdfSha256            String      @map("pdf_sha256") @db.Char(64)
  createdById          String      @map("created_by_id")
  createdAt            DateTime    @default(now()) @map("created_at")

  workspace          Workspace           @relation(fields: [workspaceId], references: [id])
  calibrationProfile CalibrationProfile? @relation(fields: [calibrationProfileId], references: [id], onDelete: SetNull)
  createdBy          User                @relation(fields: [createdById], references: [id])
  checks             Check[]

  @@index([workspaceId, createdAt])
  @@map("print_batches")
}

model CheckStatusHistory {
  id         String       @id @default(uuid())
  checkId    String       @map("check_id")
  fromStatus CheckStatus? @map("from_status")
  toStatus   CheckStatus  @map("to_status")
  changeById String       @map("changed_by_id")
  reason     String?
  ipAddress  String?      @map("ip_address") @db.VarChar(45)
  userAgent  String?      @map("user_agent") //The browser/device information
  createdAt  DateTime     @default(now()) @map("created_at")

  check     Check @relation(fields: [checkId], references: [id])
  changedBy User  @relation(fields: [changeById], references: [id])

  @@index([checkId])
  @@map("check_status_history")
}

model CheckAttachment {
  id            String   @id @default(uuid())
  checkId       String   @map("check_id")
  fileName      String   @map("file_name")
  fileType      String   @map("file_type")
  fileSizeBytes BigInt   @map("file_size_bytes")
  // Key in encrypted file storage (not a URL). Several rows may share one key: a
  // reissued check carries its original's attachments, and stored files never change.
  storageKey    String   @map("storage_key")
  // SHA-256 of the file as stored for the user (verified on every download)
  sha256        String   @db.Char(64)
  uploadedById  String   @map("uploaded_by_id")
  createdAt     DateTime @default(now()) @map("created_at")

  // Relations
  check      Check @relation(fields: [checkId], references: [id])
  uploadedBy User  @relation(fields: [uploadedById], references: [id])

  @@index([checkId])
  // Before deleting a stored file: is any other attachment still using it?
  @@index([storageKey])
  @@map("check_attachments")
}

model ApprovalWorkflowRule {
  id                String   @id @default(uuid())
  workspaceId       String   @map("workspace_id")
  priority          Int      @default(1)
  minAmount         Decimal? @map("min_amount") @db.Decimal(12, 2)
  maxAmount         Decimal? @map("max_amount") @db.Decimal(12, 2)
  requiredApprovals Int      @default(1) @map("required_approvals")
  allowSelfApproval Boolean  @default(false) @map("allow_self_approval")
  isActive          Boolean  @default(true) @map("is_active")
  createdById       String   @map("created_by_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Relations
  workspace       Workspace                  @relation(fields: [workspaceId], references: [id])
  createdBy       User                       @relation(fields: [createdById], references: [id])
  approvers       ApprovalWorkflowApprover[]
  approvalRecords ApprovalRecord[]

  @@index([workspaceId])
  @@map("approval_workflow_rules")
}

model ApprovalWorkflowApprover {
  id     String @id @default(uuid())
  ruleId String @map("rule_id")
  userId String @map("user_id")

  // Relations
  rule ApprovalWorkflowRule @relation(fields: [ruleId], references: [id])
  user User                 @relation(fields: [userId], references: [id])

  @@unique([ruleId, userId])
  @@map("approval_workflow_approvers")
}

model ApprovalRecord {
  id         String   @id @default(uuid())
  checkId    String   @map("check_id") // Which check was this decision about?
  ruleId     String   @map("rule_id") // Which rule triggered this approval?
  approverId String   @map("approver_id") // Who made the decision?
  round      Int // Check.approvalRound when the decision was made
  decision   String   @db.VarChar(10) // approved or rejected
  reason     String? // rejected reason
  createdAt  DateTime @default(now()) @map("created_at") //When was the decision made?

  //NO updatedAt. NO deletedAt. This record is IMMUTABLE.

  // Relations
  check    Check                @relation(fields: [checkId], references: [id])
  rule     ApprovalWorkflowRule @relation(fields: [ruleId], references: [id])
  approver User                 @relation(fields: [approverId], references: [id])

  // One vote per approver per round, enforced by the database so concurrent clicks cannot count twice
  @@unique([checkId, round, approverId])
  @@index([checkId])
  @@map("approval_records")
}

enum PaperSize {
  LETTER
  A4
}

// PLAIN_PAPER prints dashed tear lines between check and stubs; PERFORATED_STOCK
// (real voucher check stock) already has perforations, so nothing is printed there.
// Where the check sits on the sheet. Must match the paper in the printer's tray.
enum CheckLayout {
  CHECK_TOP
  CHECK_MIDDLE
  CHECK_BOTTOM
  THREE_PER_PAGE // three checks per sheet, no stubs
}

enum StockType {
  PLAIN_PAPER
  PERFORATED_STOCK
}

// One physical printer setup (printer + driver + tray + paper size), shared by the whole workspace.
// Offsets describe the machine, so they belong to the workspace, not to the person who measured them.
model CalibrationProfile {
  id                  String      @id @default(uuid())
  workspaceId         String      @map("workspace_id")
  calibratedById      String?     @map("calibrated_by_id")
  profileName         String      @map("profile_name")
  paperSize           PaperSize   @default(LETTER) @map("paper_size")
  stockType           StockType   @default(PLAIN_PAPER) @map("stock_type")
  layout              CheckLayout @default(CHECK_MIDDLE)
  tray                String?     @db.VarChar(50)
  horizontalOffsetPts Decimal     @default(0) @map("horizontal_offset_pts") @db.Decimal(6, 2)
  verticalOffsetPts   Decimal     @default(0) @map("vertical_offset_pts") @db.Decimal(6, 2)
  scaleX              Decimal?    @map("scale_x") @db.Decimal(6, 4)
  scaleY              Decimal?    @map("scale_y") @db.Decimal(6, 4)
  measurementsJson    Json?       @map("measurements_json")
  refVersion          Int         @default(1) @map("ref_version")
  calibratedAt        DateTime    @default(now()) @map("calibrated_at")
  // Set when a printed sample check measured within tolerance; cleared whenever offsets change.
  verifiedAt          DateTime?   @map("verified_at")
  verifiedById        String?     @map("verified_by_id")
  verificationJson    Json?       @map("verification_json")
  isDefault           Boolean     @default(false) @map("is_default")
  // Three-per-page paper: the slot the next check goes into (the sheet in the tray may be
  // partly used). Advanced after every print; shared by everyone using this printer.
  nextSlot            Int         @default(1) @map("next_slot")
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  // Relations
  workspace    Workspace    @relation(fields: [workspaceId], references: [id])
  calibratedBy User?        @relation("CalibrationProfileCalibratedBy", fields: [calibratedById], references: [id])
  verifiedBy   User?        @relation("CalibrationProfileVerifiedBy", fields: [verifiedById], references: [id])
  checks       Check[]
  printBatches PrintBatch[]

  @@index([workspaceId])
  @@map("calibration_profiles")
}

