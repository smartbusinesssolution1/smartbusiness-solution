enum UserTokenPurpose {
  PASSWORD_RESET
  INVITATION
}

// One-time links sent by email (password reset, invitation). Only a SHA-256 fingerprint
// of the token is stored. A token works while usedAt and revokedAt are null and
// expiresAt is in the future; "expired" is worked out from expiresAt, never stored.
model UserToken {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  purpose   UserTokenPurpose
  tokenHash String           @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime         @map("expires_at")
  usedAt    DateTime?        @map("used_at")
  revokedAt DateTime?        @map("revoked_at") // replaced by a newer link, or the invitation was cancelled

  // Invitations only: where the user was invited, and by whom
  tenantId    String? @map("tenant_id")
  workspaceId String? @map("workspace_id")
  createdById String? @map("created_by_id")

  createdAt DateTime @default(now()) @map("created_at")

  user      User       @relation("UserTokenOwner", fields: [userId], references: [id])
  createdBy User?      @relation("UserTokenCreatedBy", fields: [createdById], references: [id])
  tenant    Tenant?    @relation(fields: [tenantId], references: [id])
  workspace Workspace? @relation(fields: [workspaceId], references: [id])

  @@index([userId, purpose])
  @@map("user_tokens")
}

model Session {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  tokenHash     String    @map("token_hash")
  expiresAt     DateTime  @map("expires_at")
  ipAddress     String?   @map("ip_address") @db.VarChar(45)
  userAgent     String?   @map("user_agent") @db.VarChar(512)
  createdAt     DateTime  @default(now()) @map("created_at")
  revokedAt     DateTime? @map("revoked_at")
  // When this session entered a correct two-factor code. Products that require it
  // (Check Printing for its admins) look at the access token's amr, built from this.
  mfaVerifiedAt DateTime? @map("mfa_verified_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([tokenHash])
  @@map("sessions")
}

// One-time codes for when the phone is lost. Stored as keyed fingerprints (HMAC with a
// server key), so a stolen copy of the database can't be used to test guesses offline.
model MfaBackupCode {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  codeHash  String    @map("code_hash") @db.Char(64)
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, codeHash])
  @@map("mfa_backup_codes")
}

// ═══════════════════════════════════════════════════════════════
// IDEMPOTENCY RECORDS
//
// Prevents duplicate processing of financial operations when
// clients retry requests (network failures, double-clicks, etc.)
//
// How it works:
// 1. Client sends Idempotency-Key header (UUID) with request
// 2. Server checks if key exists for this user + path
// 3. If found and not expired → return stored response
// 4. If not found → process request, store key + response
// 5. Records expire after 24 hours (cleanup via cron/scheduled job)
//
// The composite unique on [key, userId] prevents one user from
// colliding with another user's keys, while still preventing
// the same user from creating duplicate resources.
// ═══════════════════════════════════════════════════════════════
model IdempotencyRecord {
  id           String   @id @default(uuid())
  key          String   @db.VarChar(255)
  userId       String   @map("user_id")
  method       String   @db.VarChar(10)
  path         String   @db.VarChar(500)
  statusCode   Int      @map("status_code")
  responseBody Json     @map("response_body")
  createdAt    DateTime @default(now()) @map("created_at")
  expiresAt    DateTime @map("expires_at")

  @@unique([key, userId])
  @@index([expiresAt])
  @@map("idempotency_records")
}

