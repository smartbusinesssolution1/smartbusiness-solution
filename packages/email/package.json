{
  "name": "@smartbusiness/email",
  "version": "0.0.1",
  "private": true,
  "description": "Shared email sending for SmartBusiness: one EmailSender interface, swappable delivery (file, memory, later a real provider), and the email templates",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "check-types": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@smartbusiness/typescript-config": "workspace:*",
    "@types/node": "^22.20.2",
    "@types/nodemailer": "^8.0.2",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "nodemailer": "^10.1.1"
  }
}
