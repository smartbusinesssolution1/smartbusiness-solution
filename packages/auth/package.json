  },
  "peerDependencies": {
    "express": "^5.0.0"
  },
  "devDependencies": {
    "@smartbusiness/typescript-config": "workspace:*",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "26.6.2"
  }
