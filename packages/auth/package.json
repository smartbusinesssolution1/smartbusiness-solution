{
  "name": "@smartbusiness/auth",
  "version": "0.0.1",
  "private": true,
  "description": "Shared authentication middleware, services, and types for SmartBusiness platform",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
