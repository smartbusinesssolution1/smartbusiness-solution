# ============================================================
# check-printing-backend — SECRETS ONLY (.env on EC2)
# ============================================================
# Non-secret config is managed in docker-compose.prod.yml:
#   PORT, NODE_ENV, REDIS_URL, CORS_ORIGIN, STORAGE_DRIVER,
#   S3_BUCKET, S3_REGION, APP_URL, RATE_LIMIT_WINDOW_MS
# Only put SECRETS here that must never go in git.
# ============================================================

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require&channel_binding=require

# ── JWT Secret (must match platform-api exactly) ─────────────
JWT_SECRET=REPLACE_WITH_SAME_JWT_SECRET_AS_PLATFORM_API

# ── Encryption Keys ──────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_HEX_KEY
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STORAGE_ENCRYPTION_KEY=REPLACE_WITH_64_BYTE_HEX_KEY
STORAGE_ENCRYPTION_KEY_ID=k1

# ── AWS (S3 attachments) ─────────────────────────────────────
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_AWS_SECRET

# ── MICR Font ────────────────────────────────────────────────
E13B_FONT_PATH=./micr/MICR.ttf
E13B_FONT_STRICT=false
PDF_STORAGE_PATH=./uploads
