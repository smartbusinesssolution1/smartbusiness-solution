NODE_ENV=development
PORT=3005

DATABASE_URL=<your-postgresql-url>

JWT_SECRET=<min-32-characters-random-string>
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7

# Frontends allowed to call this API from a browser: exact origins, comma-separated, never "*".
# e.g. CORS_ORIGIN=https://checks.smartbusiness.com,https://portal.smartbusiness.com
CORS_ORIGIN=http://localhost:5173

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# ─── File storage (check PDFs, signatures, attachments) ───
# Every stored file is encrypted with this key. 64 hex characters, DIFFERENT from
# ENCRYPTION_KEY. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STORAGE_ENCRYPTION_KEY=
STORAGE_ENCRYPTION_KEY_ID=k1
# During a key rotation only: old keys that must still open existing files (id:hex,id:hex)
STORAGE_PREVIOUS_KEYS=

# "local" = PDF_STORAGE_PATH folder (development). "s3" = S3 bucket (required in production).
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=us-east-1
# Optional folder inside the bucket, e.g. development/
S3_PREFIX=
# AWS credentials for S3. In production prefer an IAM role (then leave these out).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
