# ============================================================
# platform-api — SECRETS ONLY (.env on EC2)
# ============================================================
# Non-secret config is managed in docker-compose.prod.yml:
#   PORT, NODE_ENV, REDIS_URL, CORS_ORIGIN,
#   EMAIL_TRANSPORT, SMTP_HOST, SMTP_PORT, SMTP_SECURE,
#   ACCESS_TOKEN_EXPIRES_IN, REFRESH_TOKEN_EXPIRES_DAYS
# Only put SECRETS here that must never go in git.
# ============================================================

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require&channel_binding=require

# ── JWT / Auth ───────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_BYTE_HEX_SECRET

# ── MFA ──────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MFA_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_HEX_KEY

# ── SMTP Credentials ─────────────────────────────────────────
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM="SmartBusiness <your-email@gmail.com>"

# ── Stripe ───────────────────────────────────────────────────
STRIPE_API_KEY=sk_live_...
STRIPE_PUBLISH_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
