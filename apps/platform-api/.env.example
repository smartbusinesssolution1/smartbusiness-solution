NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://user:password@localhost:5432/smartbusiness_db
JWT_SECRET=your-jwt-secret-at-least-32-characters-long
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7
CORS_ORIGIN=http://localhost:5173
#COOKIE_DOMAIN= #leave blank for localhost
# Job queue: `docker compose -f docker-compose.dev.yml up -d` (repo root) starts Redis
REDIS_URL=redis://127.0.0.1:6379
# smtp: real sending. Locally Mailpit (docker compose -f docker-compose.dev.yml up -d),
# inbox at http://localhost:8025. Production: AWS SES SMTP endpoint and credentials.
EMAIL_TRANSPORT=smtp
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
APP_URL=http://localhost:5173
