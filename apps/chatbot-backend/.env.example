# ============================================================
# chatbot-backend — SECRETS ONLY (.env on EC2)
# ============================================================
# Non-secret config is managed in docker-compose.prod.yml:
#   REDIS_URL, WEB_CONCURRENCY, APP_ENV, CORS_ORIGINS,
#   all RATE_LIMIT_* and SESSION_* values
# Only put SECRETS here that must never go in git.
# ============================================================

# ── Database (Python psycopg2 format) ────────────────────────
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST/DBNAME?sslmode=require

# ── Security ─────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=REPLACE_WITH_32_CHAR_RANDOM_KEY
SESSION_SECRET=REPLACE_WITH_32_CHAR_RANDOM_SECRET

# ── LLM (Groq) ───────────────────────────────────────────────
GROQ_API_KEY=gsk_...
GROQ_FAST_MODEL=openai/gpt-oss-20b
GROQ_COMPLEX_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_SECONDS=25

# ── LLM Fallback (OpenRouter) ────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,openrouter/free
OPENROUTER_TIMEOUT_SECONDS=20

# ── Answer Quality / Safety ──────────────────────────────────
RETRIEVAL_CONFIDENCE_THRESHOLD=0.40
GUARDRAILS_MODE=nemo
