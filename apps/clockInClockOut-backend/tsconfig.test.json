{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "./src/**/*",
    "./test/**/*",
    "./vitest.config.mts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
