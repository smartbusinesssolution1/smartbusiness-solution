# ============================================================
# clockInClockOut-backend — SECRETS ONLY (.env on EC2)
# ============================================================
# Non-secret config is managed in docker-compose.prod.yml:
#   PORT, NODE_ENV, REDIS_URL, FACE_RECOGNITION_API_URL,
#   AWS_REGION, AWS_S3_BUCKET_NAME, SMTP_HOST, SMTP_PORT,
#   SMTP_SECURE, ORIGIN, RATE_LIMIT_WINDOWMS, RATE_LIMIT_MAX
# Only put SECRETS here that must never go in git.
# ============================================================

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require&channel_binding=require

# ── JWT Secret (must match platform-api exactly) ─────────────
JWT_ACCESS_TOKEN_SECRET=REPLACE_WITH_SAME_JWT_SECRET_AS_PLATFORM_API
JWT_ACCESS_TOKEN_EXPIRES_IN=15m

# ── AWS (S3 avatars & face embeddings) ───────────────────────
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_AWS_SECRET

# ── SMTP Credentials ─────────────────────────────────────────
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM="SmartBusiness <your-email@gmail.com>"

# ── DB Pool ──────────────────────────────────────────────────
DB_POOL_MAX=10
