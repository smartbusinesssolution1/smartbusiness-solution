# ==============================================================================
# SmartBusiness Solutions — Environment Configuration Template (.env.example)
# Copy to .env and adjust endpoints according to your environment (Local / Cloud).
# ==============================================================================

# ─── 1. FRONTEND UI URLs ───
UI_GATEWAY_URL=http://localhost
UI_CHECK_PRINTING_URL=http://localhost:5173
UI_ATTENDANCE_URL=http://localhost:5174
UI_CHATBOT_URL=http://localhost:5175
UI_PLATFORM_WEB_URL=http://localhost:3003

# ─── 2. BACKEND API URLs ───
BACKEND_ATTENDANCE_URL=http://localhost:3000
BACKEND_PLATFORM_API_URL=http://localhost:3001
BACKEND_CHECK_PRINTING_URL=http://localhost:3005
BACKEND_FACE_RECOGNITION_URL=http://localhost:8000
BACKEND_CHATBOT_URL=http://localhost:8001

# ─── 3. FRONTEND → BACKEND CONNECTION VARIABLES ───
# Check Printing Frontend (Port 5173)
PLATFORM_API_URL=http://localhost:3001
CHECK_API_URL=http://localhost:3005
VITE_PLATFORM_API_URL=http://localhost:3001
VITE_CHECK_API_URL=http://localhost:3005

# ClockIn / Attendance Frontend (Port 5174)
VITE_PLATFORM_API_URL=http://localhost:3001
VITE_CLOCKIN_API_URL=http://localhost:3000
VITE_API_URL=http://localhost:3000

# RAG Chatbot Frontend (Port 5175)
VITE_API_BASE=http://localhost:8001

# Platform Web (Port 3003)
APP_URL=http://localhost:5173

# ─── 4. BACKEND INTERSERVICE COMMUNICATION ───
FACE_RECOGNITION_API_URL=http://127.0.0.1:8000

# ─── 5. BACKEND CORS & ALLOWED ORIGINS ───
ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:3003,http://localhost
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:3003,http://localhost
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:3003,http://localhost
COOKIE_SECURE=false

# ─── 6. INFRASTRUCTURE & CREDENTIALS ───
NODE_ENV=development
DATABASE_URL=postgresql://user:pass@ep-host.neon.tech/neondb?sslmode=require
REDIS_URL=redis://127.0.0.1:6379
JWT_SECRET=your_jwt_secret_key_at_least_32_characters
JWT_ACCESS_TOKEN_SECRET=your_jwt_secret_key_at_least_32_characters
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7
ENCRYPTION_KEY=your_64_hex_character_encryption_key
STORAGE_ENCRYPTION_KEY=your_64_hex_character_storage_key
STORAGE_ENCRYPTION_KEY_ID=k1
MFA_ENCRYPTION_KEY=your_64_hex_character_mfa_key
STORAGE_DRIVER=s3
S3_BUCKET=check-printing-bucket
AWS_S3_BUCKET_NAME=clockin-clockout-bucket
S3_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
GROQ_API_KEY=your_groq_api_key
ADMIN_API_KEY=your_admin_api_key
SESSION_SECRET=your_session_secret
